NODE_ENV=development
PORT=3007
LOG_LEVEL=info
AUDIT_LOGGING_ENABLED=true
SENTRY_DSN=

JWT_ACCESS_SECRET=replace-with-auth-service-access-secret
PATIENT_DATA_ENCRYPTION_KEY=replace-with-patient-data-encryption-key
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3002,http://127.0.0.1:3002
INTERNAL_API_KEY=replace-with-shared-internal-service-key
AUTH_SERVICE_URL=http://localhost:3005
AUTH_SERVICE_URL_DOCKER=http://host.docker.internal:3005
AI_SERVICE_URL=http://localhost:3010
AI_SERVICE_URL_DOCKER=http://host.docker.internal:3010
NOTIFICATION_SERVICE_URL=http://localhost:3008
NOTIFICATION_SERVICE_URL_DOCKER=http://host.docker.internal:3008

POSTGRES_USER=medsphere
POSTGRES_PASSWORD=medsphere
POSTGRES_DB=department_service
POSTGRES_PORT=5436
DATABASE_URL=postgresql://medsphere:medsphere@localhost:5436/department_service

REDIS_PASSWORD=medsphere_redis_password
REDIS_PORT=6382
REDIS_URL=redis://:medsphere_redis_password@localhost:6382

MONGO_ROOT_USERNAME=medsphere
MONGO_ROOT_PASSWORD=medsphere
MONGO_DATABASE=medsphere
MONGO_PORT=27020
MONGODB_URI=mongodb://medsphere:medsphere@localhost:27020/medsphere?authSource=admin

CORE_SERVICE_PORT=3007
