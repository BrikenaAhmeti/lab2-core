generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  VIRTUAL
  WALK_IN
  FOLLOW_UP
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum LabResultStatus {
  PENDING
  ENTERED
  REVIEWED
  ABNORMAL
  CRITICAL
}

enum LabOrderStatus {
  PENDING
  COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PharmacyStatus {
  PENDING
  ON_HOLD
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum InventoryTransactionType {
  RECEIVED
  DISPENSED
  ADJUSTED
  TRANSFERRED
  WRITTEN_OFF
}

enum BillingStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

model Department {
  id                         String                     @id @default(uuid())
  name                       String                     @unique
  description                String?
  floor                      String?
  phoneExtension             String?                    @map("phone_extension")
  operatingHours             Json?                      @map("operating_hours")
  isActive                   Boolean                    @default(true) @map("is_active")
  sortOrder                  Int                        @default(0) @map("sort_order")
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")
  createdBy                  String?                    @db.Uuid @map("created_by")
  updatedBy                  String?                    @db.Uuid @map("updated_by")
  services                   ServiceCatalog[]
  staffDepartmentAssignments StaffDepartmentAssignment[]
  staffSchedules             StaffSchedule[]
  scheduleExceptions         ScheduleException[]
  appointments               Appointment[]
  medicalRecords             MedicalRecord[]
  labOrders                  LabOrder[]
  inventoryItems             InventoryItem[]

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
  @@map("departments")
}

model ServiceCatalog {
  id                     String        @id @default(uuid())
  departmentId           String        @map("department_id")
  name                   String
  description            String?
  defaultDurationMinutes Int           @map("default_duration_minutes")
  defaultPrice           Decimal       @db.Decimal(10, 2) @map("default_price")
  isActive               Boolean       @default(true) @map("is_active")
  sortOrder              Int           @default(0) @map("sort_order")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  createdBy              String?       @db.Uuid @map("created_by")
  updatedBy              String?       @db.Uuid @map("updated_by")
  department             Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  appointments           Appointment[]
  billingItems           BillingItem[]

  @@index([departmentId])
  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
  @@unique([departmentId, name])
  @@map("service_catalog")
}

model StaffPositionType {
  id                      String         @id @default(uuid())
  name                    String         @unique
  description             String?
  defaultRoleKey          String         @map("default_role_key")
  applicableDepartmentIds Json?          @map("applicable_department_ids")
  isActive                Boolean        @default(true) @map("is_active")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  createdBy               String?        @db.Uuid @map("created_by")
  updatedBy               String?        @db.Uuid @map("updated_by")
  staffProfiles           StaffProfile[]

  @@index([isActive])
  @@map("staff_position_types")
}

model StaffProfile {
  id                         String                     @id @default(uuid())
  userId                     String                     @unique @db.Uuid @map("user_id")
  staffPositionTypeId        String                     @map("staff_position_type_id")
  employeeCode               String                     @unique @map("employee_code")
  specialization             String?
  licenseNumber              String?                    @map("license_number")
  employmentStatus           EmploymentStatus           @default(ACTIVE) @map("employment_status")
  hireDate                   DateTime?                  @map("hire_date") @db.Date
  terminationDate            DateTime?                  @map("termination_date") @db.Date
  bio                        String?
  isPublicProfile            Boolean                    @default(false) @map("is_public_profile")
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")
  createdBy                  String?                    @db.Uuid @map("created_by")
  updatedBy                  String?                    @db.Uuid @map("updated_by")
  staffPositionType          StaffPositionType          @relation(fields: [staffPositionTypeId], references: [id], onDelete: Restrict)
  departmentAssignments      StaffDepartmentAssignment[]
  schedules                  StaffSchedule[]
  scheduleExceptions         ScheduleException[]
  appointments               Appointment[]
  medicalRecords             MedicalRecord[]
  prescriptions              Prescription[]
  labOrders                  LabOrder[]

  @@index([staffPositionTypeId])
  @@index([employmentStatus])
  @@index([isPublicProfile])
  @@map("staff_profiles")
}

model StaffDepartmentAssignment {
  id             String       @id @default(uuid())
  staffProfileId String       @map("staff_profile_id")
  departmentId   String       @map("department_id")
  isPrimary      Boolean      @default(false) @map("is_primary")
  assignedAt     DateTime     @default(now()) @map("assigned_at")
  unassignedAt   DateTime?    @map("unassigned_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdBy      String?      @db.Uuid @map("created_by")
  updatedBy      String?      @db.Uuid @map("updated_by")
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([staffProfileId, departmentId])
  @@index([departmentId])
  @@index([isPrimary])
  @@map("staff_department_assignments")
}

model StaffSchedule {
  id                  String       @id @default(uuid())
  staffProfileId      String       @map("staff_profile_id")
  departmentId        String       @map("department_id")
  dayOfWeek           Int          @map("day_of_week")
  startTime           String       @map("start_time")
  endTime             String       @map("end_time")
  slotDurationMinutes Int          @map("slot_duration_minutes")
  breakStart          String?      @map("break_start")
  breakEnd            String?      @map("break_end")
  validFrom           DateTime?    @map("valid_from") @db.Date
  validTo             DateTime?    @map("valid_to") @db.Date
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  createdBy           String?      @db.Uuid @map("created_by")
  updatedBy           String?      @db.Uuid @map("updated_by")
  staffProfile        StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  department          Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([staffProfileId, dayOfWeek])
  @@index([departmentId])
  @@index([isActive])
  @@map("staff_schedules")
}

model ScheduleException {
  id             String       @id @default(uuid())
  staffProfileId String       @map("staff_profile_id")
  departmentId   String?      @map("department_id")
  exceptionDate  DateTime     @map("exception_date") @db.Date
  startTime      String?      @map("start_time")
  endTime        String?      @map("end_time")
  isUnavailable  Boolean      @default(true) @map("is_unavailable")
  reason         String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdBy      String?      @db.Uuid @map("created_by")
  updatedBy      String?      @db.Uuid @map("updated_by")
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([staffProfileId, exceptionDate])
  @@index([departmentId])
  @@map("schedule_exceptions")
}

model Patient {
  id                String          @id @default(uuid())
  userId            String?         @unique @db.Uuid @map("user_id")
  firstName         String          @map("first_name")
  lastName          String          @map("last_name")
  email             String?
  phone             String?
  dateOfBirth       DateTime?       @map("date_of_birth") @db.Date
  gender            String?
  bloodType         BloodType?      @map("blood_type")
  personalNumber    String?         @map("personal_number")
  personalNumberHash String?        @unique @map("personal_number_hash")
  address           String?
  emergencyContact  String?         @map("emergency_contact")
  emergencyPhone    String?         @map("emergency_phone")
  allergies         Json?
  medicalNotes      Json?           @map("medical_notes")
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  createdBy         String?         @db.Uuid @map("created_by")
  updatedBy         String?         @db.Uuid @map("updated_by")
  appointments      Appointment[]
  medicalRecords    MedicalRecord[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  pharmacyQueue     PharmacyQueue[]
  billings          Billing[]
  feedback          Feedback[]

  @@index([lastName, firstName])
  @@index([email])
  @@index([phone])
  @@index([personalNumberHash])
  @@index([bloodType])
  @@index([isActive])
  @@map("patients")
}

model Appointment {
  id               String            @id @default(uuid())
  patientId        String            @map("patient_id")
  departmentId     String            @map("department_id")
  serviceCatalogId String            @map("service_catalog_id")
  staffProfileId   String?           @map("staff_profile_id")
  status           AppointmentStatus @default(SCHEDULED)
  appointmentType  AppointmentType   @default(IN_PERSON) @map("appointment_type")
  scheduledAt      DateTime          @map("scheduled_at")
  endAt            DateTime          @map("end_at")
  durationMinutes  Int               @map("duration_minutes")
  basePrice        Decimal           @db.Decimal(10, 2) @map("base_price")
  notes            String?
  checkedInAt      DateTime?         @map("checked_in_at")
  completedAt      DateTime?         @map("completed_at")
  cancelledAt      DateTime?         @map("cancelled_at")
  cancellationNote String?           @map("cancellation_note")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  createdBy        String?           @db.Uuid @map("created_by")
  updatedBy        String?           @db.Uuid @map("updated_by")
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  department       Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  serviceCatalog   ServiceCatalog    @relation(fields: [serviceCatalogId], references: [id], onDelete: Restrict)
  staffProfile     StaffProfile?     @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  billings         Billing[]
  feedback         Feedback[]

  @@index([patientId])
  @@index([departmentId])
  @@index([serviceCatalogId])
  @@index([staffProfileId])
  @@index([status])
  @@index([scheduledAt])
  @@map("appointments")
}

model MedicalRecord {
  id                     String                   @id @default(uuid())
  patientId              String                   @map("patient_id")
  appointmentId          String?                  @map("appointment_id")
  staffProfileId         String                   @map("staff_profile_id")
  departmentId           String                   @map("department_id")
  chiefComplaint         String?                  @map("chief_complaint")
  vitals                 Json?
  diagnosis              String?
  treatmentPlan          String?                  @map("treatment_plan")
  notes                  String?
  followUpInstructions   String?                  @map("follow_up_instructions")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  createdBy              String?                  @db.Uuid @map("created_by")
  updatedBy              String?                  @db.Uuid @map("updated_by")
  patient                Patient                  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment            Appointment?             @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staffProfile           StaffProfile             @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  department             Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  amendments            MedicalRecordAmendment[]
  prescriptions          Prescription[]
  labOrders              LabOrder[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([staffProfileId])
  @@index([departmentId])
  @@map("medical_records")
}

model MedicalRecordAmendment {
  id                String        @id @default(uuid())
  medicalRecordId   String        @map("medical_record_id")
  amendedByUserId   String        @db.Uuid @map("amended_by_user_id")
  reason            String
  previousSnapshot  Json?         @map("previous_snapshot")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  createdBy         String?       @db.Uuid @map("created_by")
  updatedBy         String?       @db.Uuid @map("updated_by")
  medicalRecord     MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([medicalRecordId])
  @@index([amendedByUserId])
  @@map("medical_record_amendments")
}

model Prescription {
  id             String             @id @default(uuid())
  patientId      String             @map("patient_id")
  medicalRecordId String?           @map("medical_record_id")
  appointmentId  String?            @map("appointment_id")
  staffProfileId String             @map("staff_profile_id")
  issuedAt       DateTime           @default(now()) @map("issued_at")
  expiresAt      DateTime?          @map("expires_at")
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  createdBy      String?            @db.Uuid @map("created_by")
  updatedBy      String?            @db.Uuid @map("updated_by")
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  medicalRecord  MedicalRecord?     @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  appointment    Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staffProfile   StaffProfile       @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  items          PrescriptionItem[]
  pharmacyQueue  PharmacyQueue[]

  @@index([patientId])
  @@index([medicalRecordId])
  @@index([appointmentId])
  @@index([staffProfileId])
  @@index([issuedAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                   String       @id @default(uuid())
  prescriptionId       String       @map("prescription_id")
  medicationName       String       @map("medication_name")
  dosage               String
  frequency            String
  durationInstructions String?      @map("duration_instructions")
  quantityPrescribed   Int          @map("quantity_prescribed")
  quantityDispensed    Int?         @map("quantity_dispensed")
  notes                String?
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  createdBy            String?      @db.Uuid @map("created_by")
  updatedBy            String?      @db.Uuid @map("updated_by")
  prescription         Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  dispensingItems      PharmacyDispensingItem[]

  @@index([prescriptionId])
  @@index([medicationName])
  @@map("prescription_items")
}

model LabTest {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  description   String?
  category      String?
  sampleType    String?        @map("sample_type")
  defaultPrice  Decimal?       @db.Decimal(10, 2) @map("default_price")
  referenceRange String?       @map("reference_range")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  createdBy     String?        @db.Uuid @map("created_by")
  updatedBy     String?        @db.Uuid @map("updated_by")
  labOrderItems LabOrderItem[]

  @@index([name])
  @@index([category])
  @@index([isActive])
  @@map("lab_tests")
}

model LabOrder {
  id                  String           @id @default(uuid())
  patientId           String           @map("patient_id")
  appointmentId       String?          @map("appointment_id")
  medicalRecordId     String?          @map("medical_record_id")
  orderedByStaffId    String           @map("ordered_by_staff_id")
  departmentId        String           @map("department_id")
  status              LabOrderStatus   @default(PENDING)
  priority            String?
  notes               String?
  orderedAt           DateTime         @default(now()) @map("ordered_at")
  collectedAt         DateTime?        @map("collected_at")
  completedAt         DateTime?        @map("completed_at")
  reviewedAt          DateTime?        @map("reviewed_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  createdBy           String?          @db.Uuid @map("created_by")
  updatedBy           String?          @db.Uuid @map("updated_by")
  patient             Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment         Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  medicalRecord       MedicalRecord?   @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  orderedByStaff      StaffProfile     @relation(fields: [orderedByStaffId], references: [id], onDelete: Restrict)
  department          Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  items               LabOrderItem[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([medicalRecordId])
  @@index([orderedByStaffId])
  @@index([departmentId])
  @@index([status])
  @@index([orderedAt])
  @@map("lab_orders")
}

model LabOrderItem {
  id              String          @id @default(uuid())
  labOrderId      String          @map("lab_order_id")
  labTestId       String          @map("lab_test_id")
  resultValue     String?         @map("result_value")
  resultUnit      String?         @map("result_unit")
  resultNotes     String?         @map("result_notes")
  resultStatus    LabResultStatus @default(PENDING) @map("result_status")
  isCritical      Boolean         @default(false) @map("is_critical")
  completedAt     DateTime?       @map("completed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  createdBy       String?         @db.Uuid @map("created_by")
  updatedBy       String?         @db.Uuid @map("updated_by")
  labOrder        LabOrder        @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTest         LabTest         @relation(fields: [labTestId], references: [id], onDelete: Restrict)

  @@index([labOrderId])
  @@index([labTestId])
  @@index([resultStatus])
  @@index([isCritical])
  @@map("lab_order_items")
}

model PharmacyQueue {
  id              String                 @id @default(uuid())
  prescriptionId  String                 @map("prescription_id")
  patientId       String                 @map("patient_id")
  status          PharmacyStatus         @default(PENDING)
  requestedAt     DateTime               @default(now()) @map("requested_at")
  processedAt     DateTime?              @map("processed_at")
  notes           String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  createdBy       String?                @db.Uuid @map("created_by")
  updatedBy       String?                @db.Uuid @map("updated_by")
  prescription    Prescription           @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  patient         Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  dispensingItems PharmacyDispensingItem[]

  @@index([prescriptionId])
  @@index([patientId])
  @@index([status])
  @@map("pharmacy_queue")
}

model PharmacyDispensingItem {
  id                 String         @id @default(uuid())
  pharmacyQueueId    String         @map("pharmacy_queue_id")
  prescriptionItemId String         @map("prescription_item_id")
  quantityToDispense Int            @map("quantity_to_dispense")
  quantityDispensed  Int?           @map("quantity_dispensed")
  status             PharmacyStatus @default(PENDING)
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  createdBy          String?        @db.Uuid @map("created_by")
  updatedBy          String?        @db.Uuid @map("updated_by")
  pharmacyQueue      PharmacyQueue  @relation(fields: [pharmacyQueueId], references: [id], onDelete: Cascade)
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Restrict)

  @@unique([pharmacyQueueId, prescriptionItemId])
  @@index([status])
  @@map("pharmacy_dispensing_items")
}

model InventoryCategory {
  id              String              @id @default(uuid())
  name            String              @unique
  description     String?
  parentId        String?             @map("parent_id")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  createdBy       String?             @db.Uuid @map("created_by")
  updatedBy       String?             @db.Uuid @map("updated_by")
  parent          InventoryCategory?  @relation("InventoryCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        InventoryCategory[] @relation("InventoryCategoryTree")
  inventoryItems  InventoryItem[]

  @@index([parentId])
  @@index([isActive])
  @@map("inventory_categories")
}

model InventoryItem {
  id                     String                 @id @default(uuid())
  inventoryCategoryId    String                 @map("inventory_category_id")
  departmentId           String?                @map("department_id")
  sku                    String                 @unique
  name                   String
  description            String?
  unitOfMeasure          String                 @map("unit_of_measure")
  currentStock           Decimal                @default(0) @db.Decimal(12, 2) @map("current_stock")
  reorderLevel           Decimal                @default(0) @db.Decimal(12, 2) @map("reorder_level")
  unitCost               Decimal?               @db.Decimal(10, 2) @map("unit_cost")
  expiryDate             DateTime?              @map("expiry_date") @db.Date
  isActive               Boolean                @default(true) @map("is_active")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  createdBy              String?                @db.Uuid @map("created_by")
  updatedBy              String?                @db.Uuid @map("updated_by")
  inventoryCategory      InventoryCategory      @relation(fields: [inventoryCategoryId], references: [id], onDelete: Restrict)
  department             Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  transactions           InventoryTransaction[]
  billingItems           BillingItem[]

  @@index([inventoryCategoryId])
  @@index([departmentId])
  @@index([name])
  @@index([expiryDate])
  @@index([isActive])
  @@map("inventory_items")
}

model InventoryTransaction {
  id                  String                   @id @default(uuid())
  inventoryItemId     String                   @map("inventory_item_id")
  transactionType     InventoryTransactionType @map("transaction_type")
  quantity            Decimal                  @db.Decimal(12, 2)
  unitCost            Decimal?                 @db.Decimal(10, 2) @map("unit_cost")
  batchNumber         String?                  @map("batch_number")
  expiryDate          DateTime?                @map("expiry_date") @db.Date
  referenceEntityType String?                  @map("reference_entity_type")
  referenceEntityId   String?                  @map("reference_entity_id")
  notes               String?
  performedByUserId   String?                  @db.Uuid @map("performed_by_user_id")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  createdBy           String?                  @db.Uuid @map("created_by")
  updatedBy           String?                  @db.Uuid @map("updated_by")
  inventoryItem       InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId])
  @@index([transactionType])
  @@index([expiryDate])
  @@map("inventory_transactions")
}

model Billing {
  id            String         @id @default(uuid())
  patientId     String         @map("patient_id")
  appointmentId String?        @map("appointment_id")
  billingNumber String         @unique @map("billing_number")
  status        BillingStatus  @default(PENDING)
  subtotal      Decimal        @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal        @default(0) @db.Decimal(10, 2) @map("tax_amount")
  discountAmount Decimal       @default(0) @db.Decimal(10, 2) @map("discount_amount")
  totalAmount   Decimal        @default(0) @db.Decimal(10, 2) @map("total_amount")
  amountPaid    Decimal        @default(0) @db.Decimal(10, 2) @map("amount_paid")
  dueDate       DateTime?      @map("due_date") @db.Date
  issuedAt      DateTime       @default(now()) @map("issued_at")
  paidAt        DateTime?      @map("paid_at")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  createdBy     String?        @db.Uuid @map("created_by")
  updatedBy     String?        @db.Uuid @map("updated_by")
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items         BillingItem[]
  payments      Payment[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
  @@index([issuedAt])
  @@map("billings")
}

model BillingItem {
  id               String         @id @default(uuid())
  billingId        String         @map("billing_id")
  serviceCatalogId String?        @map("service_catalog_id")
  inventoryItemId  String?        @map("inventory_item_id")
  description      String
  quantity         Decimal        @default(1) @db.Decimal(10, 2)
  unitPrice        Decimal        @default(0) @db.Decimal(10, 2) @map("unit_price")
  totalPrice       Decimal        @default(0) @db.Decimal(10, 2) @map("total_price")
  sourceEntityType String?        @map("source_entity_type")
  sourceEntityId   String?        @map("source_entity_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  createdBy        String?        @db.Uuid @map("created_by")
  updatedBy        String?        @db.Uuid @map("updated_by")
  billing          Billing        @relation(fields: [billingId], references: [id], onDelete: Cascade)
  serviceCatalog   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id], onDelete: SetNull)
  inventoryItem    InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([billingId])
  @@index([serviceCatalogId])
  @@index([inventoryItemId])
  @@map("billing_items")
}

model Payment {
  id               String        @id @default(uuid())
  billingId        String        @map("billing_id")
  amount           Decimal       @db.Decimal(10, 2)
  paymentMethod    PaymentMethod @map("payment_method")
  referenceNumber  String?       @map("reference_number")
  paidAt           DateTime      @default(now()) @map("paid_at")
  receivedByUserId String?       @db.Uuid @map("received_by_user_id")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  createdBy        String?       @db.Uuid @map("created_by")
  updatedBy        String?       @db.Uuid @map("updated_by")
  billing          Billing       @relation(fields: [billingId], references: [id], onDelete: Cascade)

  @@index([billingId])
  @@index([paymentMethod])
  @@index([paidAt])
  @@map("payments")
}

model Feedback {
  id            String      @id @default(uuid())
  patientId     String      @map("patient_id")
  appointmentId String?     @map("appointment_id")
  rating        Int
  comment       String?
  submittedAt   DateTime    @default(now()) @map("submitted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  createdBy     String?     @db.Uuid @map("created_by")
  updatedBy     String?     @db.Uuid @map("updated_by")
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([appointmentId])
  @@index([submittedAt])
  @@map("feedback")
}

model ContactMessage {
  id          String    @id @default(uuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  status      String    @default("new")
  repliedAt   DateTime? @map("replied_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String?   @db.Uuid @map("created_by")
  updatedBy   String?   @db.Uuid @map("updated_by")

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @db.Uuid @map("created_by")
  updatedBy   String?  @db.Uuid @map("updated_by")

  @@index([isPublic])
  @@map("settings")
}

model File {
  id              String   @id @default(uuid())
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id")
  storageProvider String   @map("storage_provider")
  originalName    String   @map("original_name")
  storedName      String   @map("stored_name")
  mimeType        String   @map("mime_type")
  sizeBytes       Int      @map("size_bytes")
  storagePath     String   @map("storage_path")
  publicUrl       String?  @map("public_url")
  checksum        String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @db.Uuid @map("created_by")
  updatedBy       String?  @db.Uuid @map("updated_by")

  @@index([entityType, entityId])
  @@index([mimeType])
  @@map("files")
}

model AuditLog {
  id               String   @id @default(uuid())
  entityType       String   @map("entity_type")
  entityId         String?  @map("entity_id")
  action           String
  performedByUserId String? @db.Uuid @map("performed_by_user_id")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([action])
  @@index([performedByUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ServicePermission {
  id          String   @id @default(uuid())
  name        String
  scope       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([name, scope])
  @@map("service_permissions")
}
